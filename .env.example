# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring

SECRET_KEY=bu-yerga-uzun-tasodifiy-satr-yozing
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Internetga joylaganda: CSRF_TRUSTED_ORIGINS=https://dokon.example.uz (Railway domeni avtomatik qo'shiladi)
# HTTPS orqali ishlaganda: SECURE_COOKIES=1
SECURE_COOKIES=0

# Serverga birinchi joylashda ega akkaunti (birinchi kirishda parol almashtiriladi)
OWNER_USERNAME=ega
OWNER_PASSWORD=

# Bo'sh bo'lsa lokal SQLite ishlatiladi. Neon/Supabase uchun:
# DATABASE_URL=postgresql://user:parol@host/dbname?sslmode=require
DATABASE_URL=

SHOP_NAME="Do'kon"
SHOP_ADDRESS=
SHOP_PHONE=
# Ommaviy bosh sahifa va Google qidiruvi uchun
SHOP_DESCRIPTION=
SHOP_CITY=
SHOP_HOURS=
# Google Search Console bergan HTML-teg kodi (content="..." ichidagi qiymat)
GOOGLE_SITE_VERIFICATION=
EXPIRY_WARNING_DAYS=30

# Avtomatik vazifalar vaqti (bot ishlab turganda bajariladi)
DAILY_REPORT_TIME=21:00
DEBT_REMINDER_TIME=10:00
BACKUP_TIME=21:30

# Telegram: @BotFather dan token oling, keyin "python manage.py telegram_bot" ishga tushirib
# botga /start yozing - u sizning chat ID ni aytadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Eskiz.uz SMS (ixtiyoriy)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
